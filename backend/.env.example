# Banco de dados SQLite (relativo à pasta prisma/)
DATABASE_URL="file:./dev.db"

# Segredo JWT — GERE UM SEGREDO FORTE PARA PRODUÇÃO
# Exemplo de geração: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Servidor
PORT=3333
NODE_ENV=development

# Origem permitida do frontend (CORS)
FRONTEND_URL="http://localhost:5173"

# Assistente de IA (bot estilo Kilo Code auto/free)
# Desligue com "false" para ocultar o painel no frontend
AI_BOT_ENABLED="true"
# Cadeia de modelos gratuitos — o primeiro disponível responde,
# os demais são fallback automático (cota esgotada, erro de rede...)
AI_CHAIN="gemini:gemini-2.0-flash"
# Chave gratuita do Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
# Chave do Kilo Gateway (OpenAI-compatible). Ex.: token provisório para teste.
# Cadeia sugerida para começar pelo auto/free: AI_CHAIN="kilo:kilo-auto/free"
KILO_API_KEY=""
# Teto de mensagens do bot por empresa, por dia (cota free é limitada)
AI_DAILY_CAP="100"
